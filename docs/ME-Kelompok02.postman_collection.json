    {
      "name": "4. Checkout & Pesanan",
      "item": [
        {
          "name": "12. POST Checkout (Idempoten)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Pelanggan-Id", "value": "{{pelanggan_id}}" },
              { "key": "X-Kunci-Idempoten", "value": "{{kunci_idempoten}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nama\": \"Auril Aditya\",\n  \"alamat\": \"Jalan Merdeka No. 10, Kecamatan Coblong, Bandung\",\n  \"kurir_id\": 1,\n  \"metode_pembayaran_id\": 1\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/checkout",
              "host": ["{{base_url}}"],
              "path": ["checkout"]
            },
            "description": "POST /api/checkout — 201, 409, 422. Wajib header X-Kunci-Idempoten. Kirim dua kali dengan kunci sama untuk membuktikan idempotent replay."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201, 200, 409, atau 422', function () { pm.expect([200, 201, 409, 422]).to.include(pm.response.code); });",
                  "const b = pm.response.json();",
                  "if (b && b.data && b.data.id) { pm.collectionVariables.set('pesanan_id', String(b.data.id)); }"
                ]
              }
            }
          ]
        },
